# AI Credit Scoring — Production Environment
# Copy to /opt/credit-scoring/.env and fill in values

# LLM Provider: 
USE_GEMINI=true
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# Disable Ollama in production
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
EMBED_MODEL=BAAI/bge-m3

# ChromaDB
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=/app/storage/chroma
CHROMA_COLLECTION=credit_policies
SIMILARITY_CUTOFF=0.45
RESET_CHROMA_COLLECTION_ON_INGEST=false

# Database
DATABASE_URL=sqlite:////app/data/sql_app.db

# Logging
LOG_LEVEL=WARNING
